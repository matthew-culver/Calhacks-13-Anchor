# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Written automatically by `npx convex dev` the first time you run it.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# The variables below are server-side secrets. Set them in Convex too:
#   npx convex env set NAME value

# Anthropic (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Cloud OAuth client (Web application) with the Gmail API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Safe Browsing API key
SAFE_BROWSING_API_KEY=
